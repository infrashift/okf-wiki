# okfw development tasks in zmake's modern syntax, with @name: tasks; zmake
# reads this file before the Makefile. The Makefile holds the same tasks in
# plain GNU Make syntax. Run `zmake <task>` for this file and `make <task>` (or
# `zmake -f Makefile <task>`) for the Makefile. Change both together:
# TestZMakefileMatchesMakefile checks they declare the same tasks, and
# `make zmake-check` that every task prints the same recipe under both.


# Recipes use bash: zmake-check diffs with process substitution.
SHELL=/bin/bash

BINARY_NAME=okfw
CMD_PATH=./cli/cmd/okfw
BIN_DIR=bin
DIST_DIR=dist
# The supported release platforms, <os>-<arch>: Linux on x86_64 and aarch64,
# macOS on Apple silicon.
PLATFORMS=linux-amd64 linux-arm64 darwin-arm64
MAN_DIR=$(BIN_DIR)/man/man1
GOPATH ?= $(shell go env GOPATH)
# make install puts bin/okfw and share/man/man1 under PREFIX. man searches the
# share/man beside each bin directory on PATH, so `man okfw` needs no MANPATH.
PREFIX ?= $(GOPATH)
# Stamped into the binary (`okfw --version`) and naming the dist tarballs: the
# tag when HEAD has one, else the commit. Releases are CalVer tags, vYYYY.M.N
# with no leading zeros (v2026.1.0, not v2026.01.0), so they are also semver.
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
LDFLAGS=-X github.com/infrashift/okf-wiki/internal/config.version=$(VERSION)
SHA256SUM=$(shell command -v sha256sum >/dev/null 2>&1 && echo sha256sum || echo shasum -a 256)

# Signing (optional: `make dist` never signs). The default key lives outside
# the repository so no build context or `git add -f` can pick it up. Supply
# your own with COSIGN_KEY= (a key file or a KMS URI) and, optionally,
# COSIGN_PUB= (a file; derived from the key when absent).
COSIGN_KEY_PREFIX ?= $(HOME)/.config/cosign/okfw
COSIGN_KEY ?= $(COSIGN_KEY_PREFIX).key
COSIGN_PUB ?= $(COSIGN_KEY_PREFIX).pub
# A signing config naming no transparency log or timestamp authority: signing
# stays offline and never publishes to the public Rekor log, which cosign v3
# does by default.
COSIGN_SIGNING_CONFIG=release/cosign-offline-signing-config.json

# Container settings
CONTAINER_ENGINE=podman
CONTAINER_FILE=Containerfiles/Containerfile
IMAGE_NAME=okfw-devcontainer
IMAGE_TAG=latest
CONTAINER_NAME=okfw-dev
SSH_PORT=2222
SSH_PUBKEY=$(HOME)/.ssh/id_ed25519.pub
USER_UID=$(shell id -u)

@build:
	CGO_ENABLED=0 go build -ldflags '$(LDFLAGS)' -o $(BIN_DIR)/$(BINARY_NAME) $(CMD_PATH)

# okfw is pure Go, so it cross-compiles from any host: each of these builds a
# binary for one release platform (<os>-<arch>) whatever machine runs it.
# -trimpath keeps the build machine's paths out of a binary meant to be shipped.
build-linux-amd64 build-linux-arm64 build-darwin-arm64: build-%:
	CGO_ENABLED=0 GOOS=$(word 1,$(subst -, ,$*)) GOARCH=$(word 2,$(subst -, ,$*)) go build -trimpath -ldflags '$(LDFLAGS)' -o $(BIN_DIR)/$(BINARY_NAME)-$* $(CMD_PATH)

# The man pages, generated by okfw from its own command tree. The host build
# writes them; they are the same for every platform. SOURCE_DATE_EPOCH (the
# commit time) dates them, so the pages are reproducible.
@man: build
	rm -rf $(MAN_DIR)
	SOURCE_DATE_EPOCH=$$(git log -1 --format=%ct 2>/dev/null || date +%s) $(BIN_DIR)/$(BINARY_NAME) man --dir $(MAN_DIR)

# One tarball per platform, each unpacking to a directory holding bin/okfw,
# share/man/man1/*.1, LICENSE and README.md — so copying its bin and share into
# ~/.local makes `okfw` and `man okfw` work — plus SHA256SUMS over the
# tarballs. Each tarball gets an SPDX SBOM made by syft from the binary it ships
# (Go records its modules in the binary, so this is what was linked, not what
# go.mod lists), with SHA256SUMS.sbom over the SBOMs.
@dist: $(addprefix build-,$(PLATFORMS)) man
	@command -v syft >/dev/null || { echo "make dist needs syft for the SBOMs: https://github.com/anchore/syft#installation" >&2; exit 1; }
	rm -rf $(DIST_DIR) && mkdir -p $(DIST_DIR)
	@for plat in $(PLATFORMS); do \
		name=$(BINARY_NAME)-$(VERSION)-$$plat; \
		mkdir -p $(DIST_DIR)/$$name/bin $(DIST_DIR)/$$name/share/man/man1 && \
		cp $(BIN_DIR)/$(BINARY_NAME)-$$plat $(DIST_DIR)/$$name/bin/$(BINARY_NAME) && \
		cp $(MAN_DIR)/*.1 $(DIST_DIR)/$$name/share/man/man1/ && \
		cp LICENSE README.md $(DIST_DIR)/$$name/ && \
		tar -C $(DIST_DIR) -czf $(DIST_DIR)/$$name.tar.gz $$name && \
		rm -rf $(DIST_DIR)/$$name && \
		SYFT_CHECK_FOR_APP_UPDATE=false syft scan -q file:$(BIN_DIR)/$(BINARY_NAME)-$$plat \
			-o spdx-json=$(DIST_DIR)/$$name.spdx.json && \
		echo "$(DIST_DIR)/$$name.tar.gz $(DIST_DIR)/$$name.spdx.json" || exit 1; \
	done
	cd $(DIST_DIR) && $(SHA256SUM) *.tar.gz > SHA256SUMS
	cd $(DIST_DIR) && $(SHA256SUM) *.spdx.json > SHA256SUMS.sbom

# An ECDSA P-256 key pair: what `cosign generate-key-pair` makes, and cosign's
# default signing algorithm. (cosign imports an Ed25519 key but cannot sign a
# blob with one.) cosign asks for a password to encrypt the private key.
@signing-key:
	@test ! -e $(COSIGN_KEY) || { echo "$(COSIGN_KEY) already exists; not overwriting it" >&2; exit 1; }
	@mkdir -p $(dir $(COSIGN_KEY_PREFIX)) && chmod 700 $(dir $(COSIGN_KEY_PREFIX))
	cosign generate-key-pair --output-key-prefix $(COSIGN_KEY_PREFIX)

# Signs everything `make dist` writes, each file getting a <file>.sigstore.json
# bundle, and copies the public key in as cosign.pub — COSIGN_PUB, or derived
# from the private key when that file does not exist. The key password is read
# once (or from COSIGN_PASSWORD) rather than once per file.
@sign: dist
	@command -v cosign >/dev/null || { echo "make sign needs cosign: https://docs.sigstore.dev/cosign/system_config/installation/" >&2; exit 1; }
	@case "$(COSIGN_KEY)" in *://*) ;; *) test -f $(COSIGN_KEY) || { echo "no signing key at $(COSIGN_KEY): run 'make signing-key' or set COSIGN_KEY=" >&2; exit 1; } ;; esac
	@if [ -z "$${COSIGN_PASSWORD+set}" ]; then \
		printf 'Password for $(COSIGN_KEY): ' >&2; \
		stty -echo 2>/dev/null; read -r COSIGN_PASSWORD; stty echo 2>/dev/null; echo >&2; \
	fi; \
	export COSIGN_PASSWORD; \
	for f in $(DIST_DIR)/*.tar.gz $(DIST_DIR)/SHA256SUMS $(DIST_DIR)/*.spdx.json $(DIST_DIR)/SHA256SUMS.sbom; do \
		if out=$$(cosign sign-blob -y --key $(COSIGN_KEY) --signing-config $(COSIGN_SIGNING_CONFIG) --bundle $$f.sigstore.json $$f 2>&1); \
		then echo "$$f.sigstore.json"; else echo "$$out" >&2; exit 1; fi; \
	done; \
	if [ -f "$(COSIGN_PUB)" ]; then cp $(COSIGN_PUB) $(DIST_DIR)/cosign.pub; \
	else cosign public-key --key $(COSIGN_KEY) --outfile $(DIST_DIR)/cosign.pub 2>/dev/null || exit 1; fi; \
	echo "$(DIST_DIR)/cosign.pub"
	@$(MAKE) -s verify-signatures COSIGN_PUB=$(DIST_DIR)/cosign.pub

# Checks every bundle in dist/ against COSIGN_PUB. --insecure-ignore-tlog is
# needed because `make sign` deliberately writes no transparency-log entry.
@verify-signatures:
	@ls $(DIST_DIR)/*.sigstore.json >/dev/null 2>&1 || { echo "no signatures in $(DIST_DIR)/: run 'make sign'" >&2; exit 1; }
	@for b in $(DIST_DIR)/*.sigstore.json; do \
		f=$${b%.sigstore.json}; \
		if out=$$(cosign verify-blob --key $(COSIGN_PUB) --bundle $$b --insecure-ignore-tlog=true $$f 2>&1); \
		then echo "verified $$f"; else echo "$$out" >&2; echo "FAILED $$f" >&2; exit 1; fi; \
	done

# Every task, checked by zmake-check: under `make -n` and `zmake -n` each must
# print the same recipe lines. A recursive $(MAKE) line is left out of the
# comparison — make -n prints it and zmake -n does not — but the recipe it runs
# is compared. The task list is the .PHONY list, so a task
# added to one file and not the other fails TestZMakefileMatchesMakefile, and
# a recipe changed in one fails this.
ZMAKE ?= zmake
ZMAKE_CHECK_TASKS=build build-linux-amd64 build-linux-arm64 build-darwin-arm64 man dist signing-key sign verify-signatures \
	test test-race lint fmt install ui-check integration-test e2e clean tidy docs-dev-up docs-dev-down docs-build \
	build-image run-container stop-container
@zmake-check:
	@command -v $(ZMAKE) >/dev/null || { echo "zmake-check needs zmake: https://github.com/infrashift/zmake/releases" >&2; exit 1; }
	@fail=0; for t in $(ZMAKE_CHECK_TASKS); do \
		a=$$(make -s -n -f Makefile $$t 2>&1 | grep -v '^make '); \
		b=$$($(ZMAKE) -s -n -f ZMakefile $$t 2>&1 | grep -v '^zmake '); \
		if [ "$$a" != "$$b" ]; then echo "zmake-check: $$t differs between Makefile and ZMakefile:" >&2; \
			diff <(echo "$$a") <(echo "$$b") >&2; fail=1; fi; \
	done; [ $$fail = 0 ] && echo "zmake-check: the Makefile and ZMakefile agree on every task"

# -count=1 disables the test cache: a cached pass can otherwise hide a
# regression in code the cache key did not notice.
@test:
	@echo "Running Go tests..."
	go test -count=1 -cover ./...
	@echo "Validating CUE schema syntax..."
	@echo "(concept conformance is checked by internal/config/fixtures_test.go)"
	cue vet ./internal/config/concept-schema.cue

@test-race:
	go test -count=1 -race ./...

@lint:
	@echo "Running linters..."
	go vet ./...
	@if command -v staticcheck >/dev/null; then \
		staticcheck ./...; \
	else \
		echo "staticcheck not installed: go install honnef.co/go/tools/cmd/staticcheck@latest"; \
		exit 1; \
	fi
	gofmt -l ./cli ./internal ./pkg
	go mod tidy -diff

@fmt:
	go fmt ./...
	@command -v cue >/dev/null && cue fmt ./internal/config/concept-schema.cue || true

@install: man
	mkdir -p $(PREFIX)/bin $(PREFIX)/share/man/man1
	cp $(BIN_DIR)/$(BINARY_NAME) $(PREFIX)/bin/$(BINARY_NAME)
	cp $(MAN_DIR)/*.1 $(PREFIX)/share/man/man1/

@ui-check:
	@echo "Checking Lua syntax..."
	luacheck lua/ plugin/ test/

# Re-clone when plenary.job is missing, not only when the directory is: an
# emptied or half-cloned checkout passed `test -d` and failed the suite.
PLENARY_DIR := /tmp/nvim-test-plugins/plenary.nvim
@integration-test: build
	@echo "Running NeoVim plugin integration tests..."
	@test -f $(PLENARY_DIR)/lua/plenary/job.lua || { rm -rf $(PLENARY_DIR) && git clone --depth 1 https://github.com/nvim-lua/plenary.nvim $(PLENARY_DIR); }
	nvim --headless -u NONE -l test/integration_test.lua

# The e2e image runs its tests as build steps, so a failed assertion fails the
# build. It runs the NeoVim plugin suite against the okfw binary in a clean
# container.
@e2e:
	@echo "Building containerized e2e image (runs the tests inside the container)..."
	$(CONTAINER_ENGINE) build -f Containerfiles/Containerfile.e2e -t okfw-e2e:latest .
	@echo "e2e build succeeded — okfw CLI and the NeoVim plugin pass in-container."

@clean:
	rm -rf $(BIN_DIR) $(DIST_DIR)
	
@tidy:
	go mod tidy

BUN ?= bun

# The project's own documentation site (docs/). docs-dev-up starts the Astro
# dev server in the background and docs-dev-down stops it, freeing the port;
# Astro records the server in docs/.astro/dev.json, so no pid file is needed.
# Starlight's search runs only on a built site, so use docs-build (or
# `bun run preview` after it) to try search. A wiki's own site is a different
# thing: `okfw site up` / `okfw site down`.
@docs-dev-up:
	cd docs && $(BUN) install --frozen-lockfile && $(BUN) --bun run astro dev --background

@docs-dev-down:
	cd docs && $(BUN) --bun run astro dev stop

@docs-build:
	cd docs && $(BUN) install --frozen-lockfile && $(BUN) --bun run build

@build-image:
	$(CONTAINER_ENGINE) build --build-arg USER_UID=$(USER_UID) --build-arg VERSION=$(VERSION) -f $(CONTAINER_FILE) -t $(IMAGE_NAME):$(IMAGE_TAG) .

@run-container:
	$(CONTAINER_ENGINE) run -d --name $(CONTAINER_NAME) \
		--userns=keep-id \
		-p $(SSH_PORT):2222 \
		-v $(SSH_PUBKEY):/home/user/.ssh/authorized_keys:ro,Z \
		$(IMAGE_NAME):$(IMAGE_TAG)

@stop-container:
	$(CONTAINER_ENGINE) stop $(CONTAINER_NAME) && $(CONTAINER_ENGINE) rm $(CONTAINER_NAME)
